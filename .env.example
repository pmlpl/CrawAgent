# ============================================================
# CrawAgent 环境变量（可选）
# ============================================================
#
# 绝大多数情况，你**不需要**这个文件。
# 模型配置全部放在 models.json 中，直接编辑那个文件即可。
#
# 如果你不想把 API Key 写进 models.json，可以在这里设置环境变量，
# 然后在 models.json 的 api_key 字段填 "$ENV_VAR_NAME"。
#
# ============================================================
# 模型 API Keys
# ============================================================
DEEPSEEK_API_KEY=sk-xxxx          # DeepSeek 模型
MIMO_API_KEY=tp-xxxx              # MIMO 模型（Token Plan）

# ============================================================
# 数据库配置
# ============================================================
# 数据库类型: sqlite 或 mysql（默认 sqlite）
# CRAWAGENT_DB_TYPE=sqlite

# MySQL 配置（如果使用 MySQL）
# CRAWAGENT_MYSQL_HOST=localhost
# CRAWAGENT_MYSQL_PORT=3306
# CRAWAGENT_MYSQL_USER=root
# CRAWAGENT_MYSQL_PASSWORD=your_password
# CRAWAGENT_MYSQL_DATABASE=crawagent

# ============================================================
# 使用示例
# ============================================================
# 在 Windows PowerShell 中：
#   $env:MIMO_API_KEY="tp-xxxx"
#   python main.py
#
# 或创建 .env 文件（不要提交到 Git！）：
#   MIMO_API_KEY=tp-xxxx
#   CRAWAGENT_MYSQL_PASSWORD=your_password
