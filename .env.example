# DeepSeek API 配置（兼容 OpenAI 接口格式）
OPENAI_API_KEY=your_deepseek_api_key_here
OPENAI_BASE_URL=https://api.deepseek.com/v1
DEFAULT_MODEL=deepseek-v4-flash

# 可选的多模型列表（逗号分隔）；为空时前端回退到 DEFAULT_MODEL
MODELS=

# 思考深度：off / low / medium / high / max（max→API 实际传 xhigh；off 不传 reasoning_effort）
THINKING_DEPTH=off

# 多服务商模型注册表（WebUI 设置页维护）：JSON 数组，每项
# {"name": 服务商名, "base_url": 接口地址, "api_key": 密钥, "models": [模型 ID...],
#  "context_window": 可选，该服务商下模型的最大上下文（token，最高 1048576/1M）——
#   不填则按模型名查内置静态表；中转站/代理商模型名静态表覆盖不到时建议手填}
# 为空时回退到上面的旧全局 OPENAI_* 配置
LLM_PROVIDERS=

# 视频子 Agent 专用模型：必须与主模型不同（同模型 = 同 DeepSeek 缓存池，命中率会被挤掉）
VIDEO_FINDER_MODEL=deepseek-v4-flash

# 媒体下载根目录（图片/视频/音频）与文本产物根目录
DOWNLOADS_DIR=./downloads
OUTPUT_DIR=./output

# 历史消息裁剪（Token 膨胀治理）
HISTORY_MAX_TOKENS=32000
HISTORY_KEEP_RECENT_TURNS=3
TOOL_RESULT_MAX_CHARS=2000


# 爬虫配置
REQUEST_TIMEOUT=30
REQUEST_DELAY=1.0
MAX_CONTENT_LENGTH=50000
FFMPEG_PATH=
BILIBILI_COOKIE=
# VIP 章节代理 API（番茄小说等）；留空则不启用
LOCKED_CHAPTER_API=

# LangSmith 调试（可选）
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=crawagent

# ---- MCP 服务器（Model Context Protocol，可选增强）----
# JSON 数组，每项一个 server；支持 streamable_http/sse（长驻服务）与 stdio（子进程，每次工具调用重启一次）。
# 单个 server 连不上只跳过它自己，不影响其它 server。
# 推荐配置（二装一或全装）：
#   1) fetch — 官方网页抓取（把 URL 转成 LLM 友好的 Markdown）。装进项目 venv 后用 venv 解释器直拉，
#      避免 uvx 在 Windows 上每次启动重新下载依赖导致握手超时：
#        uv pip install mcp-server-fetch
#      然后 command 用 {project_root} 占位符引用项目 venv（见下）。
#   2) playwright — 微软官方浏览器自动化（24 个 browser_* 工具：导航/点击/截图/表单…）。
#      npm 全局安装拿到固定二进制（不要用 npx @latest，每次 spawn 都查 registry）：
#        npm i -g @playwright/mcp
#      command 填 npm 全局 bin 的完整路径，如 C:/Users/<user>/AppData/Roaming/npm/playwright-mcp.cmd
# 示例（fetch + playwright + 自定义 streamable_http 服务）：
# MCP_SERVERS=[{"name":"anything","transport":"streamable_http","url":"http://127.0.0.1:23816/mcp","headers":{"Authorization":"Bearer <token>"}},{"name":"fetch","transport":"stdio","command":"{project_root}/.venv/Scripts/python.exe","args":["-m","mcp_server_fetch"]},{"name":"playwright","transport":"stdio","command":"C:/Users/<user>/AppData/Roaming/npm/playwright-mcp.cmd","args":["--headless","--isolated","--browser","chrome"]}]
# 留空 = 不启用 MCP。
MCP_SERVERS=
# True = 第一个 server 未运行时自动在后台拉起 MCP_START_COMMAND（anything-analyzer 有内置拉起逻辑）
MCP_AUTOSTART=false
# 拉起 MCP 服务的命令（shell 执行，如 bootstrap 脚本或 docker start ...）
MCP_START_COMMAND=
