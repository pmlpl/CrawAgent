# CrawAgent 环境变量
# 只填你要用的，不填的留空或注释掉

# ============================================================
# 模型配置（任意 OpenAI 兼容 API）
# ============================================================
# DeepSeek
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# DEFAULT_MODEL=deepseek-chat

# OpenAI
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# DEFAULT_MODEL=gpt-4o-mini

# 智谱
# OPENAI_API_KEY=xxx
# OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# DEFAULT_MODEL=glm-4

# 百川
# OPENAI_API_KEY=xxx
# OPENAI_BASE_URL=https://api.baichuan-ai.com/v1
# DEFAULT_MODEL=Baichuan4

# 月之暗面
# OPENAI_API_KEY=xxx
# OPENAI_BASE_URL=https://api.moonshot.cn/v1
# DEFAULT_MODEL=moonshot-v1-8k

# Ollama 本地
# OLLAMA_BASE_URL=http://localhost:11434
# DEFAULT_MODEL=qwen2.5:7b

# ============================================================
# 爬虫行为
# ============================================================
# PER_DOMAIN_RATE=0.5
# MAX_CONCURRENT=50
# REQUEST_TIMEOUT=30.0
# MAX_RETRIES=3
# IMPERSONATE=chrome120
# USE_CURL_CFFI=true

# ============================================================
# 数据库（本地开发默认 localhost；docker compose 部署时自动指向服务名）
# ============================================================
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=crawagent
# MYSQL_PASSWORD=crawagent
# MYSQL_DATABASE=crawagent

# ============================================================
# Redis（缓存/队列）
# ============================================================
# REDIS_URL=redis://localhost:6379/0

# ============================================================
# Agent Harness
# ============================================================
# HARNESS_MAX_TURNS=50
# HARNESS_COMPACTION_THRESHOLD=80000
# HARNESS_DEFAULT_LANE=main

# ============================================================
# 应用与日志
# ============================================================
# DEBUG=false
# LOG_LEVEL=INFO
# LOG_FILE=logs/crawagent.log
# DATA_DIR=data

# ============================================================
# Docker Compose 部署（仅 docker compose 使用）
# ============================================================
# 暴露端口
# MYSQL_PORT=3306
# REDIS_PORT=6379
# BACKEND_PORT=8000
# FRONTEND_PORT=3000
